{
  "name": "skeleton-motion",
  "version": "0.1.0",
  "description": "Generate coordinated, branded product-motion asset sets from a repository or URL.",
  "type": "module",
  "bin": {
    "skeleton-motion": "./bin/skeleton-motion.js"
  },
  "scripts": {
    "generate": "node ./bin/skeleton-motion.js",
    "docs:build": "docusaurus build website",
    "worker:dev": "npm run docs:build && wrangler dev",
    "worker:migrate": "wrangler d1 migrations apply skeleton-motion-jobs --remote",
    "worker:deploy": "npm run docs:build && wrangler deploy",
    "docs:serve": "docusaurus serve website",
    "docs:start": "docusaurus start website",
    "test": "node --test",
    "check": "node --check ./bin/skeleton-motion.js && node --test",
    "verify": "npm run check && npm run docs:build",
    "audit:fill": "node ./scripts/audit-fill.mjs",
    "tint:landing": "node ./scripts/tint-landing-assets.mjs",
    "build:preview-shell": "npm --prefix tools/preview-shell install && npm --prefix tools/preview-shell run build && node scripts/sync-preview-shell.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "postcss-selector-parser": "7.1.6",
    "serialize-javascript": "7.1.2",
    "tinypool": "2.2.0",
    "uuid": "14.0.2"
  },
  "license": "MIT"
}
