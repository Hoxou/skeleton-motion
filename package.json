{
  "name": "skeleton-motion",
  "version": "0.1.0",
  "description": "Generate coordinated, branded product-motion asset sets from a repository or URL.",
  "type": "module",
  "bin": {
    "skeleton-motion": "./bin/skeleton-motion.js"
  },
  "scripts": {
    "generate": "node ./bin/skeleton-motion.js",
    "docs:build": "docusaurus build website",
    "docs:serve": "docusaurus serve website",
    "docs:start": "docusaurus start website",
    "test": "node --test",
    "check": "node --check ./bin/skeleton-motion.js && node --test",
    "verify": "npm run check && npm run docs:build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/themes": "^3.3.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "postcss-selector-parser": "7.1.6",
    "serialize-javascript": "7.1.2",
    "tinypool": "2.2.0",
    "uuid": "14.0.2"
  },
  "license": "MIT"
}
